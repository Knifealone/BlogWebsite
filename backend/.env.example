# Copy to .env.local if you need to change anything. The defaults work out of the box.

# Where the API lives. "/api" works with the dev proxy and when one server hosts both.
VITE_API_URL=/api

# Only if the API is on a different origin than the site (uploaded photos use it).
# VITE_ASSET_ORIGIN=https://api.example.com

# Dev proxy target. Change it if the server runs on another port.
# VITE_PROXY_TARGET=http://localhost:4000

# Hero slides on the home page come from your existing backend (GET /homes).
# Include the prefix if your routes are mounted under one, e.g. /api. Leave empty for built-in slides.
# VITE_HOME_API_URL=http://localhost:5000
